    rotation: 0
    state: enabled
- name: epy_block_2
  id: epy_block
  parameters:
    _source_code: "import time\n\nimport numpy as np\nimport pmt\nfrom gnuradio import\
      \ gr\n\n\nclass blk(gr.basic_block):\n    \"\"\"\n    Monitor de vaz\xE3o e\
      \ goodput.\n\n    Portas de entrada (uint8, bit a bit, com tags 'quadro' marcando\
      \ o\n    in\xEDcio de cada quadro; o valor da tag \xE9 o comprimento do quadro\
      \ em\n    bits):\n\n    Porta 0: sa\xEDda do decodificador FEC (RX), ANTES do\
      \ CRC check. Usada\n        pra contar bits recebidos (vaz\xE3o) e como rel\xF3\
      gio de sinal (cada\n        item vale 1/taxa_relogio segundos).\n\n    Porta\
      \ 1: sa\xEDda do CRC Check (RX, check=True). S\xF3 os quadros que\n        passaram\
      \ no CRC chegam aqui, j\xE1 sem os bits de CRC (packed=False).\n        Usada\
      \ pra contar bits \xFAteis (goodput).\n\n    A cada janela_s segundos de sinal,\
      \ emite (e opcionalmente imprime):\n        0 vaz\xE3o janela [bit/s]    \n\
      \        1 vaz\xE3o total [bit/s]\n        2 goodput janela [bit/s]  \n    \
      \    3 goodput total [bit/s]\n    \"\"\"\n\n    def __init__(self, tag_name=\"\
      quadro\", taxa_relogio=800e3,\n                 janela_s=1.0, aquecimento_s=0.0,\
      \ imprimir=False):\n        gr.basic_block.__init__(\n            self,\n  \
      \          name=\"Monitor Vaz\xE3o/Goodput\",\n            in_sig=[np.uint8,\
      \ np.uint8],\n            out_sig=[np.float32] * 4,\n        )\n        self.chave_tag\
      \ = pmt.intern(tag_name)\n        self.taxa_relogio = float(taxa_relogio)\n\
      \        self.janela_s = float(janela_s)\n        self.aquecimento_s = float(aquecimento_s)\n\
      \        self.imprimir = bool(imprimir)\n        self.em_aquecimento = self.aquecimento_s\
      \ > 0\n\n        # contadores acumulados desde o in\xEDcio (ou desde o fim do\
      \ aquecimento)\n        self.relogio = 0          # itens (bits) consumidos\
      \ na porta 0\n        self.bits_recebidos = 0   # bits dos quadros recebidos\
      \ (com CRC)\n        self.bits_validos = 0     # bits \xFAteis dos quadros v\xE1\
      lidos\n\n        # \"foto\" dos contadores no momento do \xFAltimo relat\xF3\
      rio, para\n        # calcular s\xF3 o que aconteceu na janela atual (por subtra\xE7\
      \xE3o)\n        self.contadores_ultimo_relatorio = (0, 0, 0)\n        self.proximo_relatorio_em_s\
      \ = self.janela_s\n\n    def forecast(self, noutput_items, ninputs):\n     \
      \   # N\xE3o exige um m\xEDnimo de itens de entrada: o bloco s\xF3 reporta\n\
      \        # quando alguma das portas trouxer dados, e n\xE3o fica em polling.\n\
      \        return [0, 0]\n\n    def general_work(self, input_items, output_items):\n\
      \        itens_porta_0 = len(input_items[0])\n        if itens_porta_0:\n  \
      \          for tag in self.get_tags_in_window(\n                    0, 0, itens_porta_0,\
      \ self.chave_tag):\n                self.bits_recebidos += pmt.to_long(tag.value)\n\
      \            self.relogio += itens_porta_0\n            self.consume(0, itens_porta_0)\n\
      \n        itens_porta_1 = len(input_items[1])\n        if itens_porta_1:\n \
      \           for tag in self.get_tags_in_window(\n                    1, 0, itens_porta_1,\
      \ self.chave_tag):\n                self.bits_validos += pmt.to_long(tag.value)\n\
      \            self.consume(1, itens_porta_1)\n\n        tempo_sinal_s = self.relogio\
      \ / self.taxa_relogio\n\n        if self.em_aquecimento and tempo_sinal_s >=\
      \ self.aquecimento_s:\n            self.em_aquecimento = False\n           \
      \ self.relogio = 0\n            self.bits_recebidos = 0\n            self.bits_validos\
      \ = 0\n            self.contadores_ultimo_relatorio = (0, 0, 0)\n          \
      \  self.proximo_relatorio_em_s = self.janela_s\n            if self.imprimir:\n\
      \                print(f\"[aquecimento] {tempo_sinal_s:.2f}s de sinal \"\n \
      \                     f\"descartados; contadores zerados\", flush=True)\n  \
      \          return 0\n\n        pode_escrever_saida = len(output_items[0]) >=\
      \ 1\n        if tempo_sinal_s >= self.proximo_relatorio_em_s and pode_escrever_saida:\n\
      \            self.proximo_relatorio_em_s = (\n                tempo_sinal_s\
      \ // self.janela_s + 1) * self.janela_s\n            for indice_saida, valor\
      \ in enumerate(self.montar_relatorio()):\n                output_items[indice_saida][0]\
      \ = valor\n            return 1\n        return 0\n\n    def calcular_taxas(self,\
      \ itens_no_periodo, bits_recebidos, bits_validos):\n        tempo_s = itens_no_periodo\
      \ / self.taxa_relogio\n        vazao_bps = bits_recebidos / tempo_s if tempo_s\
      \ else 0.0\n        goodput_bps = bits_validos / tempo_s if tempo_s else 0.0\n\
      \        return tempo_s, vazao_bps, goodput_bps\n\n    def montar_relatorio(self):\n\
      \        (relogio_anterior, bits_recebidos_anterior,\n         bits_validos_anterior)\
      \ = self.contadores_ultimo_relatorio\n\n        tempo_s_janela, vazao_bps_janela,\
      \ goodput_bps_janela = (\n            self.calcular_taxas(\n               \
      \ self.relogio - relogio_anterior,\n                self.bits_recebidos - bits_recebidos_anterior,\n\
      \                self.bits_validos - bits_validos_anterior,\n            ))\n\
      \        tempo_s_total, vazao_bps_total, goodput_bps_total = (\n           \
      \ self.calcular_taxas(\n                self.relogio, self.bits_recebidos, self.bits_validos))\n\
      \n        valores_saida = [\n            vazao_bps_janela, vazao_bps_total,\n\
      \            goodput_bps_janela, goodput_bps_total,\n        ]\n\n        if\
      \ self.imprimir:\n            print(\n                f\"[janela] sinal={tempo_s_janela:7.2f}s\
      \  \"\n                f\"vaz\xE3o={vazao_bps_janela / 1e3:7.1f} kb/s \"\n \
      \               f\"goodput={goodput_bps_janela / 1e3:7.1f} kb/s\",\n       \
      \         flush=True,\n            )\n            print(\n                f\"\
      [total ] sinal={tempo_s_total:7.2f}s  \"\n                f\"vaz\xE3o={vazao_bps_total\
      \ / 1e3:7.1f} kb/s \"\n                f\"goodput={goodput_bps_total / 1e3:7.1f}\
      \ kb/s\",\n                flush=True,\n            )\n\n        self.contadores_ultimo_relatorio\
      \ = (\n            self.relogio, self.bits_recebidos, self.bits_validos)\n \
      \       return valores_saida"
    affinity: ''
    alias: ''
    aquecimento_s: aquecimento_segundos
    comment: ''
    imprimir: 'False'
