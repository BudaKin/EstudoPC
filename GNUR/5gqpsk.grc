- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.basic_block):\n\
      \    def __init__(self, access_code=\"\", payload_len_in_bits=0):\n        gr.basic_block.__init__(\n\
      \            self,\n            name='Find Access Code',\n            in_sig=[np.uint8],\n\
      \            out_sig=[np.uint8],\n        )\n        self.access_code = np.array([int(b)\
      \ for b in access_code])\n        self.payload_len_in_bits = payload_len_in_bits\n\
      \n    def general_work(self, input_items, output_items):\n        in0 = input_items[0]\n\
      \        out0 = output_items[0]\n        ac_len = self.access_code.size\n  \
      \      pl_len = self.payload_len_in_bits\n        if len(in0) < ac_len + pl_len:\n\
      \            return 0\n        if len(out0) < pl_len:\n    \t        return\
      \ 0\n        if not np.array_equal(in0[:ac_len], self.access_code):\n      \
      \     self.consume(0, 1)  # N\xE3o \xE9 o mais otimizado. :D\n           return\
      \ 0\n        self.consume(0, ac_len + pl_len)\n        out0[:pl_len] = in0[ac_len:\
      \ ac_len + pl_len]\n        return pl_len\n\n"
    access_code: access_code
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    payload_len_in_bits: payload_len * 8
  states:
    _io_cache: ('Find Access Code', 'blk', [('access_code', "''"), ('payload_len_in_bits',
      '0')], [('0', 'byte', 1)], [('0', 'byte', 1)], '', ['access_code', 'payload_len_in_bits'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1960, 808.0]
    rotation: 0
    state: true
