- name: epy_block_0_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nimport pmt\nfrom gnuradio import gr\n\n\nclass\
      \ blk(gr.basic_block):\n    \"\"\"\n    Find Access Code \u2014 invariante \xE0\
      s quatro ambiguidades de fase da QPSK.\n\n    Procura o access code no fluxo\
      \ de LLRs correlacionando, em paralelo, contra\n    as quatro vers\xF5es do\
      \ c\xF3digo correspondentes \xE0s rota\xE7\xF5es de 0\xB0, 90\xB0, 180\xB0 e\n\
      \    270\xB0 da constela\xE7\xE3o. Ao encontrar, desfaz a rota\xE7\xE3o no payload\
      \ antes de\n    repass\xE1-lo adiante, de modo que o Costas Loop pode travar\
      \ em qualquer uma\n    das quatro fases sem quebrar o enquadramento.\n    \"\
      \"\"\n\n    def __init__(self, access_code=\"\", payload_len_in_bits=0, tag_key=\"\
      \", threshold=0.9):\n        gr.basic_block.__init__(\n            self,\n \
      \           name='Find Access Code',\n            in_sig=[np.float32],\n   \
      \         out_sig=[np.float32],\n        )\n        ac = np.array([2 * int(b)\
      \ - 1 for b in access_code], dtype=np.float32)\n        if ac.size % 2 or payload_len_in_bits\
      \ % 2:\n            raise ValueError('access code e payload devem ter comprimento\
      \ par')\n        self.codes = np.stack([self._rot(ac, k) for k in range(4)])\n\
      \        self.ac_len = ac.size\n        self.pl_len = int(payload_len_in_bits)\n\
      \        self.frame_len = self.ac_len + self.pl_len\n        self.tag_key =\
      \ pmt.intern(tag_key)\n        self.threshold = threshold\n        if self.pl_len\
      \ > 0:\n            # Sob os valores padr\xE3o (payload 0) o GRC instancia o\
      \ bloco s\xF3 para\n            # inspecionar as portas; set_output_multiple(0)\
      \ daria erro ali.\n            self.set_output_multiple(self.pl_len)\n\n   \
      \ @staticmethod\n    def _rot(x, k):\n        \"\"\"Aplica k rota\xE7\xF5es\
      \ de +90\xB0 ao fluxo de LLRs (cada par de LLRs = 1 s\xEDmbolo).\"\"\"\n   \
      \     y = x.reshape(-1, 2).copy()\n        for _ in range(k % 4):\n        \
      \    a = y[:, 0].copy()\n            y[:, 0] = y[:, 1]\n            y[:, 1]\
      \ = -a\n        return y.reshape(-1)\n\n    def forecast(self, noutput_items,\
      \ ninputs):\n        return [self.frame_len] * ninputs\n\n    def general_work(self,\
      \ input_items, output_items):\n        in0 = input_items[0]\n        out0 =\
      \ output_items[0]\n\n        if self.pl_len <= 0:\n            return 0\n  \
      \      if in0.size < self.frame_len or out0.size < self.pl_len:\n          \
      \  return 0\n\n        # Busca vetorizada: testa de uma vez todos os offsets\
      \ em que ainda cabe\n        # um quadro inteiro, limitada a um per\xEDodo de\
      \ quadro por chamada.\n        last = min(in0.size - self.frame_len, self.frame_len\
      \ - 1)\n        w = np.lib.stride_tricks.sliding_window_view(in0[:last + self.ac_len],\
      \ self.ac_len)\n        energy = np.abs(w).sum(axis=1)\n        metric = (w\
      \ @ self.codes.T) / np.where(energy > 0.0, energy, np.inf)[:, None]\n\n    \
      \    idx = np.flatnonzero(metric.max(axis=1) >= self.threshold)\n        if\
      \ idx.size == 0:\n            self.consume(0, last + 1)   # descarta o que j\xE1\
      \ foi testado, guarda a cauda\n            return 0\n\n        n = int(idx[0])\
      \                      # primeiro quadro do bloco\n        k = int(np.argmax(metric[n]))\
      \        # qual das 4 rota\xE7\xF5es casou\n        payload = in0[n + self.ac_len:\
      \ n + self.frame_len]\n        out0[:self.pl_len] = self._rot(payload, -k) \
      \  # desfaz a rota\xE7\xE3o\n        self.consume(0, n + self.frame_len)\n \
      \       self.add_item_tag(0, self.nitems_written(0), self.tag_key, pmt.from_long(self.pl_len))\n\
      \        return self.pl_len\n"
    access_code: access_code
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    payload_len_in_bits: N
    tag_key: '"quadro"'
    threshold: '0.6'
  states:
    _io_cache: "('Find Access Code', 'blk', [('access_code', \"''\"), ('payload_len_in_bits',\
      \ '0'), ('tag_key', \"''\"), ('threshold', '0.9')], [('0', 'float', 1)], [('0',\
      \ 'float', 1)], '\\nFind Access Code \u2014 invariante \xE0s quatro ambiguidades\
      \ de fase da QPSK.\\n\\nProcura o access code no fluxo de LLRs correlacionando,\
      \ em paralelo, contra\\nas quatro vers\xF5es do c\xF3digo correspondentes \xE0\
      s rota\xE7\xF5es de 0\xB0, 90\xB0, 180\xB0 e\\n270\xB0 da constela\xE7\xE3o.\
      \ Ao encontrar, desfaz a rota\xE7\xE3o no payload antes de\\nrepass\xE1-lo adiante,\
      \ de modo que o Costas Loop pode travar em qualquer uma\\ndas quatro fases sem\
      \ quebrar o enquadramento.\\n', ['tag_key', 'threshold'])"
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1376, 800.0]
    rotation: 0
    state: enabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import time\nfrom collections import deque\n\nimport numpy as np\n\
      import pmt\nfrom gnuradio import gr\n\n\nclass blk(gr.basic_block):\n    \"\"\
      \"\n    Monitor de BLER, BER residual, vaz\xE3o e goodput.\n\n    Portas de\
      \ entrada (todas uint8, bit a bit, com tags 'quadro' marcando\n    o in\xED\
      cio de cada quadro; o valor da tag \xE9 o comprimento do quadro em\n    bits):\n\
      \n    Porta 0: sa\xEDda do decodificador FEC (RX), ANTES do CRC check. Usada\n\
      \        pra contar quadros/bits recebidos (BLER/vaz\xE3o) e pra extrair o\n\
      \        conte\xFAdo de bits de cada quadro decodificado (para a BER).\n\n \
      \   Porta 1: sa\xEDda do CRC Check (RX, check=True). S\xF3 os quadros que\n\
      \        passaram no CRC chegam aqui. Usada s\xF3 pra contar quadros/bits\n\
      \        v\xE1lidos (BLER/goodput).\n\n    Porta 2: sa\xEDda do CRC Add do TX\
      \ (check=False) \u2014 ou seja, o bit stream\n        de REFER\xCANCIA, exatamente\
      \ o que devia ter sido recebido, sem\n        ru\xEDdo/erro de canal. Usada\
      \ pra calcular a BER residual, comparando\n        cada quadro decodificado\
      \ (porta 0) com o quadro de refer\xEAncia\n        correspondente.\n\n    Como\
      \ a porta 2 \xE9 a sa\xEDda do pr\xF3prio transmissor, ela chega mais cedo\n\
      \    do que o quadro decodificado equivalente na porta 0 (o RX tem atraso\n\
      \    de sincronismo/decodifica\xE7\xE3o). Por isso os quadros de refer\xEAncia\n\
      \    completos s\xE3o guardados numa fila (fila_referencia) e s\xF3 consumidos\n\
      \    quando o quadro decodificado correspondente chega. Antes do primeiro\n\
      \    sincronismo, essa fila N\xC3O tem limite de tamanho \u2014 do contr\xE1\
      rio, um\n    atraso de aquisi\xE7\xE3o do RX (Costas loop / symbol sync) maior\
      \ que o\n    limite descartaria justamente os quadros de refer\xEAncia que\n\
      \    corresponderiam ao primeiro quadro decodificado, for\xE7ando um\n    sincronismo\
      \ travado numa posi\xE7\xE3o errada. S\xF3 depois de sincronizar\n    pela primeira\
      \ vez a fila passa a ter um teto (tamanho_max_fila_pos_sync),\n    j\xE1 que\
      \ em regime permanente ela deve ficar sempre curta.\n\n    Sincroniza\xE7\xE3\
      o: como n\xE3o existe nenhum \xEDndice expl\xEDcito dizendo \"isso \xE9\n  \
      \  o quadro N\", o bloco descobre o alinhamento certo procurando, dentro\n \
      \   de uma janela de quadros de refer\xEAncia pendentes, aquele com menor\n\
      \    dist\xE2ncia de Hamming em rela\xE7\xE3o ao quadro decodificado recebido.\
      \ Uma\n    vez sincronizado, assume-se alinhamento sequencial (1 quadro da fila\n\
      \    por quadro decodificado) at\xE9 que a taxa de erro de um quadro\n    espec\xED\
      fico sugira que o alinhamento se perdeu, disparando uma nova\n    busca.\n\n\
      \    Sa\xEDdas (float32):\n    0 BLER janela    1 BLER total\n    2 BER  janela\
      \    3 BER  total\n    4 vaz\xE3o janela   5 vaz\xE3o total\n    6 goodput janela\
      \ 7 goodput total\n    \"\"\"\n\n    def __init__(self, tag_name=\"quadro\"\
      , taxa_relogio=800e3,\n                 bits_por_quadro_tx=1056, janela_s=1.0,\n\
      \                 aquecimento_s=0.0, imprimir=False,\n                 janela_busca_quadros=50,\
      \ limiar_dessincronismo=0.3):\n        gr.basic_block.__init__(\n          \
      \  self,\n            name=\"Monitor BLER/BER/vaz\xE3o\",\n            in_sig=[np.uint8,\
      \ np.uint8, np.uint8],\n            out_sig=[np.float32] * 8,\n        )\n \
      \       self.chave_tag = pmt.intern(tag_name)\n        self.taxa_relogio = float(taxa_relogio)\n\
      \        self.bits_por_quadro_tx = int(bits_por_quadro_tx)\n        self.janela_s\
      \ = float(janela_s)\n        self.aquecimento_s = float(aquecimento_s)\n   \
      \     self.imprimir = bool(imprimir)\n        self.em_aquecimento = self.aquecimento_s\
      \ > 0\n        self.janela_busca_quadros = int(janela_busca_quadros)\n     \
      \   self.limiar_dessincronismo = float(limiar_dessincronismo)\n\n        # contadores\
      \ acumulados desde o in\xEDcio (ou desde o fim do aquecimento)\n        self.relogio\
      \ = 0                # itens (bits) consumidos na porta 0\n        self.quadros_recebidos\
      \ = 0      # quadros que chegaram ao CRC (porta 0)\n        self.quadros_validos\
      \ = 0        # quadros que passaram no CRC (porta 1)\n        self.bits_recebidos\
      \ = 0         # bits dos quadros recebidos (com CRC)\n        self.bits_validos\
      \ = 0           # bits \xFAteis dos quadros v\xE1lidos\n        self.bits_comparados\
      \ = 0        # total de bits comparados p/ BER\n        self.bits_errados =\
      \ 0           # bits diferentes entre RX e refer\xEAncia\n\n        # \"foto\"\
      \ dos contadores no momento do \xFAltimo relat\xF3rio, para\n        # calcular\
      \ s\xF3 o que aconteceu na janela atual (por subtra\xE7\xE3o)\n        self.contadores_ultimo_relatorio\
      \ = (0, 0, 0, 0, 0, 0, 0)\n        self.tempo_parede_inicio = time.monotonic()\n\
      \        self.tempo_parede_ultimo_relatorio = self.tempo_parede_inicio\n   \
      \     self.proximo_relatorio_em_s = self.janela_s\n\n        # estado da extra\xE7\
      \xE3o de quadros completos (porta 0 = RX decodificado,\n        # porta 2 =\
      \ refer\xEAncia do TX) a partir do stream de bits + tags\n        self._comprimento_quadro_em_andamento\
      \ = {0: None, 2: None}\n        self._bits_quadro_em_andamento = {0: [], 2:\
      \ []}\n\n        # fila de quadros de refer\xEAncia recebidos e ainda n\xE3\
      o usados numa\n        # compara\xE7\xE3o. Sem limite (None) at\xE9 o primeiro\
      \ sincronismo, pra n\xE3o\n        # descartar justamente os quadros que o primeiro\
      \ quadro decodificado\n        # vai precisar (o atraso de aquisi\xE7\xE3o do\
      \ RX pode ser grande). Depois\n        # de sincronizar, passa a ter teto \u2014\
      \ em regime permanente a fila\n        # deve ficar sempre curta, ent\xE3o isso\
      \ s\xF3 evita crescimento\n        # descontrolado se o RX parar de decodificar\
      \ quadros.\n        self.tamanho_max_fila_pos_sincronismo = self.janela_busca_quadros\
      \ * 4\n        self.fila_referencia = deque()\n        self.sincronizado = False\n\
      \n    def forecast(self, noutput_items, ninputs):\n        # N\xE3o exige um\
      \ m\xEDnimo de itens de entrada: o bloco s\xF3 reporta\n        # quando alguma\
      \ das portas trouxer dados, e n\xE3o fica em polling.\n        return [0, 0,\
      \ 0]\n\n    # ------------------------------------------------------------------\n\
      \    # extra\xE7\xE3o de quadros completos a partir do stream de bits + tags\n\
      \    # ------------------------------------------------------------------\n\
      \    def _extrair_quadros_completos(self, porta, dados):\n        \"\"\"\n \
      \       Recebe o array de bits novos de uma porta nesta chamada e devolve\n\
      \        a lista de quadros completos (arrays numpy de bits) que puderam\n \
      \       ser fechados. O que ainda estiver incompleto fica guardado em\n    \
      \    self._bits_quadro_em_andamento[porta] para a pr\xF3xima chamada, j\xE1\n\
      \        que um quadro pode chegar picotado em v\xE1rias chamadas.\n       \
      \ \"\"\"\n        quadros_completos = []\n        n = len(dados)\n        if\
      \ n == 0:\n            return quadros_completos\n\n        tags = self.get_tags_in_window(porta,\
      \ 0, n, self.chave_tag)\n        comprimento_por_posicao = {\n            tag.offset\
      \ - self.nitems_read(porta): pmt.to_long(tag.value)\n            for tag in\
      \ tags\n        }\n\n        posicao = 0\n        while posicao < n:\n     \
      \       if self._comprimento_quadro_em_andamento[porta] is None:\n         \
      \       if posicao not in comprimento_por_posicao:\n                    # bits\
      \ soltos antes do primeiro quadro reconhecido\n                    # (s\xF3\
      \ deve acontecer logo no in\xEDcio da execu\xE7\xE3o)\n                    posicao\
      \ += 1\n                    continue\n                self._comprimento_quadro_em_andamento[porta]\
      \ = (\n                    comprimento_por_posicao[posicao])\n             \
      \   self._bits_quadro_em_andamento[porta] = []\n\n            faltam = (self._comprimento_quadro_em_andamento[porta]\n\
      \                      - len(self._bits_quadro_em_andamento[porta]))\n     \
      \       pegar = min(faltam, n - posicao)\n            self._bits_quadro_em_andamento[porta].extend(\n\
      \                dados[posicao:posicao + pegar].tolist())\n            posicao\
      \ += pegar\n\n            if (len(self._bits_quadro_em_andamento[porta])\n \
      \                   == self._comprimento_quadro_em_andamento[porta]):\n    \
      \            quadros_completos.append(np.array(\n                    self._bits_quadro_em_andamento[porta],\
      \ dtype=np.uint8))\n                self._comprimento_quadro_em_andamento[porta]\
      \ = None\n                self._bits_quadro_em_andamento[porta] = []\n\n   \
      \     return quadros_completos\n\n    # ------------------------------------------------------------------\n\
      \    # alinhamento do quadro decodificado com a fila de refer\xEAncia\n    #\
      \ ------------------------------------------------------------------\n    def\
      \ _distancia_hamming(self, quadro_a, quadro_b):\n        tamanho = min(len(quadro_a),\
      \ len(quadro_b))\n        erros = int(np.sum(quadro_a[:tamanho] != quadro_b[:tamanho]))\n\
      \        return erros, tamanho\n\n    def _buscar_melhor_alinhamento(self, quadro_rx,\
      \ quantidade_a_pesquisar):\n        \"\"\"\n        Procura, dentro dos primeiros\
      \ `quantidade_a_pesquisar` quadros de\n        refer\xEAncia pendentes, o que\
      \ tem menor dist\xE2ncia de Hamming em\n        rela\xE7\xE3o ao quadro decodificado.\
      \ Descarta da fila tudo que vier\n        antes do encontrado (refer\xEAncia\
      \ \"perdida\", nunca vai ser usada)\n        junto com o pr\xF3prio quadro encontrado\
      \ (j\xE1 consumido nesta\n        compara\xE7\xE3o).\n\n        `quantidade_a_pesquisar`\
      \ \xE9 quem decide o alcance da busca: no\n        sincronismo inicial, deve\
      \ ser a fila inteira (o atraso de\n        aquisi\xE7\xE3o do RX pode ser grande\
      \ e ainda desconhecido); nas\n        re-buscas ap\xF3s j\xE1 estar sincronizado,\
      \ uma janela pequena\n        (janela_busca_quadros) j\xE1 basta, porque o drift\
      \ esperado \xE9 s\xF3\n        local.\n\n        Retorna (quadro_referencia_usado,\
      \ distancia) ou (None, None) se a\n        fila ainda n\xE3o tiver quadros suficientes\
      \ pra buscar.\n        \"\"\"\n        melhor_indice = None\n        melhor_distancia\
      \ = None\n        limite = min(len(self.fila_referencia), quantidade_a_pesquisar)\n\
      \        for indice in range(limite):\n            distancia, _ = self._distancia_hamming(\n\
      \                quadro_rx, self.fila_referencia[indice])\n            if melhor_distancia\
      \ is None or distancia < melhor_distancia:\n                melhor_distancia\
      \ = distancia\n                melhor_indice = indice\n\n        if melhor_indice\
      \ is None:\n            return None, None\n\n        quadro_referencia_usado\
      \ = None\n        for _ in range(melhor_indice + 1):\n            quadro_referencia_usado\
      \ = self.fila_referencia.popleft()\n\n        return quadro_referencia_usado,\
      \ melhor_distancia\n\n    def _comparar_com_referencia(self, quadro_rx):\n \
      \       \"\"\"\n        Retorna (bits_errados, bits_comparados) desse quadro\
      \ decodificado\n        em rela\xE7\xE3o \xE0 refer\xEAncia, ou (0, 0) se ainda\
      \ n\xE3o h\xE1 refer\xEAncia\n        suficiente na fila pra comparar.\n   \
      \     \"\"\"\n        if not self.fila_referencia:\n            return 0, 0\n\
      \n        if not self.sincronizado:\n            # busca inicial: varre a fila\
      \ INTEIRA, n\xE3o s\xF3 uma janela.\n            # O atraso de aquisi\xE7\xE3\
      o do RX ainda \xE9 desconhecido aqui, e\n            # pode facilmente passar\
      \ de janela_busca_quadros quadros.\n            quadro_referencia, _ = self._buscar_melhor_alinhamento(\n\
      \                quadro_rx, quantidade_a_pesquisar=len(self.fila_referencia))\n\
      \            if quadro_referencia is None:\n                return 0, 0\n  \
      \          self.sincronizado = True\n            return self._distancia_hamming(quadro_rx,\
      \ quadro_referencia)\n\n        quadro_referencia = self.fila_referencia.popleft()\n\
      \        erros, tamanho = self._distancia_hamming(quadro_rx, quadro_referencia)\n\
      \n        if tamanho and erros / tamanho > self.limiar_dessincronismo:\n   \
      \         # taxa de erro suspeita demais: prov\xE1vel perda de alinhamento.\n\
      \            # devolve a refer\xEAncia j\xE1 retirada e tenta achar uma posi\xE7\
      \xE3o\n            # melhor considerando tamb\xE9m ela. Aqui sim usamos s\xF3\
      \ uma\n            # janela pequena (janela_busca_quadros): j\xE1 est\xE1vamos\n\
      \            # sincronizados, ent\xE3o o desalinhamento esperado \xE9 local.\n\
      \            self.fila_referencia.appendleft(quadro_referencia)\n          \
      \  candidata, distancia_candidata = self._buscar_melhor_alinhamento(\n     \
      \           quadro_rx, quantidade_a_pesquisar=self.janela_busca_quadros)\n \
      \           if candidata is not None and distancia_candidata < erros:\n    \
      \            quadro_referencia = candidata\n                erros, tamanho =\
      \ self._distancia_hamming(\n                    quadro_rx, quadro_referencia)\n\
      \n        return erros, tamanho\n\n    # ------------------------------------------------------------------\n\
      \    # la\xE7o principal (roda no general_work, thread do scheduler)\n    #\
      \ ------------------------------------------------------------------\n    def\
      \ general_work(self, input_items, output_items):\n        # --- porta 0: quadros\
      \ que chegam ao decodificador (antes do CRC) ---\n        itens_porta_0 = len(input_items[0])\n\
      \        quadros_rx_completos = []\n        if itens_porta_0:\n            for\
      \ tag in self.get_tags_in_window(\n                    0, 0, itens_porta_0,\
      \ self.chave_tag):\n                self.quadros_recebidos += 1\n          \
      \      self.bits_recebidos += pmt.to_long(tag.value)\n            self.relogio\
      \ += itens_porta_0\n            quadros_rx_completos = self._extrair_quadros_completos(\n\
      \                0, input_items[0])\n            self.consume(0, itens_porta_0)\n\
      \n        # --- porta 1: quadros que passaram no CRC (RX) ---\n        itens_porta_1\
      \ = len(input_items[1])\n        if itens_porta_1:\n            for tag in self.get_tags_in_window(\n\
      \                    1, 0, itens_porta_1, self.chave_tag):\n               \
      \ self.quadros_validos += 1\n                self.bits_validos += pmt.to_long(tag.value)\n\
      \            self.consume(1, itens_porta_1)\n\n        # --- porta 2: refer\xEA\
      ncia (sa\xEDda do CRC Add do TX, sem canal) ---\n        itens_porta_2 = len(input_items[2])\n\
      \        if itens_porta_2:\n            quadros_referencia_completos = self._extrair_quadros_completos(\n\
      \                2, input_items[2])\n            self.fila_referencia.extend(quadros_referencia_completos)\n\
      \            if self.sincronizado:\n                # s\xF3 depois de sincronizado\
      \ impomos um teto: antes disso a\n                # fila precisa poder crescer\
      \ o quanto for necess\xE1rio pra\n                # cobrir o atraso de aquisi\xE7\
      \xE3o do RX\n                while len(self.fila_referencia) > self.tamanho_max_fila_pos_sincronismo:\n\
      \                    self.fila_referencia.popleft()\n            self.consume(2,\
      \ itens_porta_2)\n\n        # --- compara cada quadro decodificado com a refer\xEA\
      ncia (BER) ---\n        for quadro_rx in quadros_rx_completos:\n           \
      \ erros, tamanho = self._comparar_com_referencia(quadro_rx)\n            self.bits_comparados\
      \ += tamanho\n            self.bits_errados += erros\n\n        tempo_sinal_s\
      \ = self.relogio / self.taxa_relogio\n\n        if self.em_aquecimento and tempo_sinal_s\
      \ >= self.aquecimento_s:\n            self.em_aquecimento = False\n        \
      \    self.relogio = 0\n            self.quadros_recebidos = 0\n            self.quadros_validos\
      \ = 0\n            self.bits_recebidos = 0\n            self.bits_validos =\
      \ 0\n            self.bits_comparados = 0\n            self.bits_errados = 0\n\
      \            self.fila_referencia = deque()\n            self.sincronizado =\
      \ False\n            self.contadores_ultimo_relatorio = (0, 0, 0, 0, 0, 0, 0)\n\
      \            self.tempo_parede_inicio = time.monotonic()\n            self.tempo_parede_ultimo_relatorio\
      \ = self.tempo_parede_inicio\n            self.proximo_relatorio_em_s = self.janela_s\n\
      \            if self.imprimir:\n                print(f\"[aquecimento] {tempo_sinal_s:.2f}s\
      \ de sinal \"\n                      f\"descartados; contadores zerados\", flush=True)\n\
      \            return 0\n\n        pode_escrever_saida = len(output_items[0])\
      \ >= 1\n        if tempo_sinal_s >= self.proximo_relatorio_em_s and pode_escrever_saida:\n\
      \            self.proximo_relatorio_em_s = (\n                tempo_sinal_s\
      \ // self.janela_s + 1) * self.janela_s\n            for indice_saida, valor\
      \ in enumerate(self._montar_relatorio()):\n                output_items[indice_saida][0]\
      \ = valor\n            return 1\n        return 0\n\n    # ------------------------------------------------------------------\n\
      \    # c\xE1lculo das m\xE9tricas e montagem do relat\xF3rio\n    # ------------------------------------------------------------------\n\
      \    def _calcular_metricas(self, itens_no_periodo, quadros_recebidos,\n   \
      \                         quadros_validos, bits_recebidos, bits_validos,\n \
      \                           bits_comparados, bits_errados):\n        tempo_s\
      \ = itens_no_periodo / self.taxa_relogio\n        quadros_esperados = itens_no_periodo\
      \ / self.bits_por_quadro_tx\n        bler = (1.0 - quadros_validos / quadros_recebidos\n\
      \                if quadros_recebidos else float(\"nan\"))\n        fer = (1.0\
      \ - quadros_validos / quadros_esperados\n               if quadros_esperados\
      \ else float(\"nan\"))\n        ber = (bits_errados / bits_comparados\n    \
      \           if bits_comparados else float(\"nan\"))\n        vazao_bps = bits_recebidos\
      \ / tempo_s if tempo_s else 0.0\n        goodput_bps = bits_validos / tempo_s\
      \ if tempo_s else 0.0\n        return (tempo_s, quadros_esperados, bler, fer,\
      \ ber, vazao_bps,\n                goodput_bps)\n\n    def _montar_relatorio(self):\n\
      \        agora = time.monotonic()\n        (relogio_anterior, quadros_recebidos_anterior,\n\
      \         quadros_validos_anterior, bits_recebidos_anterior,\n         bits_validos_anterior,\
      \ bits_comparados_anterior,\n         bits_errados_anterior) = self.contadores_ultimo_relatorio\n\
      \n        # m\xE9tricas da janela (delta desde o \xFAltimo relat\xF3rio)\n \
      \       (tempo_s_janela, quadros_esperados_janela, bler_janela, fer_janela,\n\
      \         ber_janela, vazao_bps_janela, goodput_bps_janela) = (\n          \
      \  self._calcular_metricas(\n                self.relogio - relogio_anterior,\n\
      \                self.quadros_recebidos - quadros_recebidos_anterior,\n    \
      \            self.quadros_validos - quadros_validos_anterior,\n            \
      \    self.bits_recebidos - bits_recebidos_anterior,\n                self.bits_validos\
      \ - bits_validos_anterior,\n                self.bits_comparados - bits_comparados_anterior,\n\
      \                self.bits_errados - bits_errados_anterior,\n            ))\n\
      \n        # m\xE9tricas totais (acumuladas desde o in\xEDcio)\n        (tempo_s_total,\
      \ quadros_esperados_total, bler_total, fer_total,\n         ber_total, vazao_bps_total,\
      \ goodput_bps_total) = (\n            self._calcular_metricas(\n           \
      \     self.relogio,\n                self.quadros_recebidos,\n             \
      \   self.quadros_validos,\n                self.bits_recebidos,\n          \
      \      self.bits_validos,\n                self.bits_comparados,\n         \
      \       self.bits_errados,\n            ))\n\n        valores_saida = [\n  \
      \          bler_janela, bler_total,\n            ber_janela, ber_total,\n  \
      \          vazao_bps_janela, vazao_bps_total,\n            goodput_bps_janela,\
      \ goodput_bps_total,\n        ]\n\n        if self.imprimir:\n            print(\n\
      \                f\"[janela] sinal={tempo_s_janela:7.2f}s  \"\n            \
      \    f\"esperados={quadros_esperados_janela:9.1f}  \"\n                f\"BLER={bler_janela:.3e}\
      \ FER={fer_janela:.3e} \"\n                f\"BER={ber_janela:.3e}  \"\n   \
      \             f\"vaz\xE3o={vazao_bps_janela / 1e3:7.1f} kb/s \"\n          \
      \      f\"goodput={goodput_bps_janela / 1e3:7.1f} kb/s\",\n                flush=True,\n\
      \            )\n            print(\n                f\"[total ] sinal={tempo_s_total:7.2f}s\
      \  \"\n                f\"esperados={quadros_esperados_total:9.1f}  \"\n   \
      \             f\"BLER={bler_total:.3e} FER={fer_total:.3e} \"\n            \
      \    f\"BER={ber_total:.3e}  \"\n                f\"vaz\xE3o={vazao_bps_total\
      \ / 1e3:7.1f} kb/s \"\n                f\"goodput={goodput_bps_total / 1e3:7.1f}\
      \ kb/s\",\n                flush=True,\n            )\n\n        self.contadores_ultimo_relatorio\
      \ = (\n            self.relogio, self.quadros_recebidos, self.quadros_validos,\n\
      \            self.bits_recebidos, self.bits_validos, self.bits_comparados,\n\
      \            self.bits_errados)\n        self.tempo_parede_ultimo_relatorio\
      \ = agora\n        return valores_saida"
    affinity: ''
    alias: ''
    aquecimento_s: '1.0'
    bits_por_quadro_tx: sync_len + N
    comment: ''
    imprimir: 'False'
    janela_busca_quadros: '2000'
    janela_s: '0.0125'
    limiar_dessincronismo: '0.0000125'
