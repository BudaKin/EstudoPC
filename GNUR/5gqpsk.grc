- name: epy_block_4
  id: epy_block
  parameters:
    _source_code: "import time\n\nimport numpy as np\nimport pmt\nfrom gnuradio import\
      \ gr\n\n\nclass blk(gr.basic_block):\n    \"\"\"\n    Monitor de BLER (Block\
      \ Error Rate).\n\n    Portas de entrada (uint8, bit a bit, com tags 'quadro'\
      \ marcando o\n    in\xEDcio de cada quadro; o valor da tag \xE9 o comprimento\
      \ do quadro em\n    bits):\n\n    Porta 0: sa\xEDda do decodificador FEC (RX),\
      \ ANTES do CRC check. Usada\n        pra contar quadros recebidos.\n\n    Porta\
      \ 1: sa\xEDda do CRC Check (RX, check=True). S\xF3 os quadros que\n        passaram\
      \ no CRC chegam aqui. Usada pra contar quadros v\xE1lidos.\n\n    A cada janela_s\
      \ segundos de sinal, emite (e opcionalmente imprime):\n        0 BLER janela\
      \   \n        1 BLER total\n    \"\"\"\n\n    def __init__(self, tag_name=\"\
      quadro\", taxa_relogio=800e3,\n                 janela_s=1.0, aquecimento_s=0.0,\
      \ imprimir=False):\n        gr.basic_block.__init__(\n            self,\n  \
      \          name=\"Monitor BLER\",\n            in_sig=[np.uint8, np.uint8],\n\
      \            out_sig=[np.float32] * 2,\n        )\n        self.chave_tag =\
      \ pmt.intern(tag_name)\n        self.taxa_relogio = float(taxa_relogio)\n  \
      \      self.janela_s = float(janela_s)\n        self.aquecimento_s = float(aquecimento_s)\n\
      \        self.imprimir = bool(imprimir)\n        self.em_aquecimento = self.aquecimento_s\
      \ > 0\n\n        # contadores acumulados desde o in\xEDcio (ou desde o fim do\
      \ aquecimento)\n        self.relogio = 0            # itens (bits) consumidos\
      \ na porta 0\n        self.quadros_recebidos = 0  # quadros que chegaram ao\
      \ CRC (porta 0)\n        self.quadros_validos = 0    # quadros que passaram\
      \ no CRC (porta 1)\n\n        # \"foto\" dos contadores no momento do \xFAltimo\
      \ relat\xF3rio, para\n        # calcular s\xF3 o que aconteceu na janela atual\
      \ (por subtra\xE7\xE3o)\n        self.contadores_ultimo_relatorio = (0, 0)\n\
      \        self.proximo_relatorio_em_s = self.janela_s\n\n    def forecast(self,\
      \ noutput_items, ninputs):\n        # N\xE3o exige um m\xEDnimo de itens de\
      \ entrada: o bloco s\xF3 reporta\n        # quando alguma das portas trouxer\
      \ dados, e n\xE3o fica em polling.\n        return [0, 0]\n\n    def general_work(self,\
      \ input_items, output_items):\n        itens_porta_0 = len(input_items[0])\n\
      \        if itens_porta_0:\n            for tag in self.get_tags_in_window(\n\
      \                    0, 0, itens_porta_0, self.chave_tag):\n               \
      \ self.quadros_recebidos += 1\n            self.relogio += itens_porta_0\n \
      \           self.consume(0, itens_porta_0)\n\n        itens_porta_1 = len(input_items[1])\n\
      \        if itens_porta_1:\n            for tag in self.get_tags_in_window(\n\
      \                    1, 0, itens_porta_1, self.chave_tag):\n               \
      \ self.quadros_validos += 1\n            self.consume(1, itens_porta_1)\n\n\
      \        tempo_sinal_s = self.relogio / self.taxa_relogio\n\n        if self.em_aquecimento\
      \ and tempo_sinal_s >= self.aquecimento_s:\n            self.em_aquecimento\
      \ = False\n            self.relogio = 0\n            self.quadros_recebidos\
      \ = 0\n            self.quadros_validos = 0\n            self.contadores_ultimo_relatorio\
      \ = (0, 0)\n            self.proximo_relatorio_em_s = self.janela_s\n      \
      \      if self.imprimir:\n                print(f\"[aquecimento] {tempo_sinal_s:.2f}s\
      \ de sinal \"\n                      f\"descartados; contadores zerados\", flush=True)\n\
      \            return 0\n\n        pode_escrever_saida = len(output_items[0])\
      \ >= 1\n        if tempo_sinal_s >= self.proximo_relatorio_em_s and pode_escrever_saida:\n\
      \            self.proximo_relatorio_em_s = (\n                tempo_sinal_s\
      \ // self.janela_s + 1) * self.janela_s\n            for indice_saida, valor\
      \ in enumerate(self.montar_relatorio()):\n                output_items[indice_saida][0]\
      \ = valor\n            return 1\n        return 0\n\n    def calcular_bler(self,\
      \ quadros_recebidos, quadros_validos):\n        if not quadros_recebidos:\n\
      \            return float(\"nan\")\n        return 1.0 - quadros_validos / quadros_recebidos\n\
      \n    def montar_relatorio(self):\n        (quadros_recebidos_anterior, quadros_validos_anterior)\
      \ = (\n            self.contadores_ultimo_relatorio)\n\n        bler_janela\
      \ = self.calcular_bler(\n            self.quadros_recebidos - quadros_recebidos_anterior,\n\
      \            self.quadros_validos - quadros_validos_anterior,\n        )\n \
      \       bler_total = self.calcular_bler(\n            self.quadros_recebidos,\
      \ self.quadros_validos)\n\n        if self.imprimir:\n            print(\n \
      \               f\"[janela] recebidos={self.quadros_recebidos - quadros_recebidos_anterior:7d}\
      \ \"\n                f\"v\xE1lidos={self.quadros_validos - quadros_validos_anterior:7d}\
      \  \"\n                f\"BLER={bler_janela:.3e}\",\n                flush=True,\n\
      \            )\n            print(\n                f\"[total ] recebidos={self.quadros_recebidos:7d}\
      \ \"\n                f\"v\xE1lidos={self.quadros_validos:7d}  \"\n        \
      \        f\"BLER={bler_total:.3e}\",\n                flush=True,\n        \
      \    )\n\n        self.contadores_ultimo_relatorio = (\n            self.quadros_recebidos,\
      \ self.quadros_validos)\n        return [bler_janela, bler_total]"
    affinity: ''
    alias: ''
    aquecimento_s: aquecimento_segundos
    comment: ''
    imprimir: 'False'
    janela_s: att_segundos
    maxoutbuf: '0'
    minoutbuf: '0'
    tag_name: tag_name
    taxa_relogio: bit_rate
  states:
    _io_cache: "('Monitor BLER', 'blk', [('tag_name', \"'quadro'\"), ('taxa_relogio',\
      \ '800000.0'), ('janela_s', '1.0'), ('aquecimento_s', '0.0'), ('imprimir', 'False')],\
      \ [('0', 'byte', 1), ('1', 'byte', 1)], [('0', 'float', 1), ('1', 'float', 1)],\
      \ \"\\nMonitor de BLER (Block Error Rate).\\n\\nPortas de entrada (uint8, bit\
      \ a bit, com tags 'quadro' marcando o\\nin\xEDcio de cada quadro; o valor da\
      \ tag \xE9 o comprimento do quadro em\\nbits):\\n\\nPorta 0: sa\xEDda do decodificador\
      \ FEC (RX), ANTES do CRC check. Usada\\n    pra contar quadros recebidos.\\\
      n\\nPorta 1: sa\xEDda do CRC Check (RX, check=True). S\xF3 os quadros que\\\
      n    passaram no CRC chegam aqui. Usada pra contar quadros v\xE1lidos.\\n\\\
      nA cada janela_s segundos de sinal, emite (e opcionalmente imprime):\\n    0\
      \ BLER janela   \\n    1 BLER total\\n\", ['aquecimento_s', 'imprimir', 'janela_s',\
      \ 'taxa_relogio'])"
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2480, 776.0]
    rotation: 0
    state: disabled
