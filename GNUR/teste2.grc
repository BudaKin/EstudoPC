options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: teste
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Teste2
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: PC_dec
  id: variable_polar_decoder_sc_def
  parameters:
    block_size: '16'
    comment: ''
    dim1: '1'
    dim2: '4'
    frozen_bit_positions: '[0,1,2,3,4,5,8,9]'
    frozen_bit_values: '[0,0,0,0,0,0,0,0]'
    ndim: '0'
    num_info_bits: '8'
