- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import time\n\nimport numpy as np\nimport pmt\nfrom gnuradio import\
      \ gr\n\n\nclass blk(gr.basic_block):\n    \"\"\"\n    Monitor de BLER e vaz\xE3\
      o a partir das portas de mensagem do CRC Check.\n\n    Mensagens 'ok' e 'fail':\
      \ PDUs vindas do CRC Check (com Discard CRC = Yes as\n        duas chegam sem\
      \ o CRC; crc_bits \xE9 somado de volta para contar a vaz\xE3o).\n        Cada\
      \ PDU \xE9 um quadro que chegou ao decodificador; 'ok' \xE9 um quadro v\xE1\
      lido.\n\n    Entrada 0 (float): sa\xEDda do Constellation Soft Decoder (LLRs).\
      \ Serve s\xF3 de\n        rel\xF3gio: cada item vale 1/taxa_relogio segundos\
      \ de sinal (2 LLRs por\n        s\xEDmbolo QPSK => taxa_relogio = bit_rate).\
      \ O tempo \xE9 medido em \"tempo de\n        sinal\", independente do throttle,\
      \ e os quadros perdidos no sincronismo\n        (que nunca viram PDU) entram\
      \ na conta.\n\n    A cada janela_s segundos de sinal emite (e, com imprimir=True,\
      \ imprime):\n        esperados = T * taxa_relogio / bits_por_quadro_tx   (quadros\
      \ transmitidos)\n        BLER      = 1 - v\xE1lidos/recebidos      (s\xF3 quadros\
      \ que chegaram ao decodificador)\n        FER       = 1 - v\xE1lidos/esperados\
      \      (inclui quadros perdidos no sincronismo)\n        vaz\xE3o     = bits\
      \ que saem do decodificador (com CRC) / T\n        goodput   = bits \xFAteis\
      \ dos quadros v\xE1lidos / T\n\n    aquecimento_s: tempo de sinal descartado\
      \ no in\xEDcio (transit\xF3rio de aquisi\xE7\xE3o);\n        ao fim dele todos\
      \ os contadores s\xE3o zerados.\n\n    Sa\xEDdas (float, um item por relat\xF3\
      rio, para QT GUI Number Sink):\n        0 BLER  1 FER  2 vaz\xE3o [bit/s]  3\
      \ goodput [bit/s]   -- janela\n        4 BLER  5 FER  6 vaz\xE3o [bit/s]  7\
      \ goodput [bit/s]   -- total\n    \"\"\"\n\n    def __init__(self, taxa_relogio=800e3,\
      \ bits_por_quadro_tx=1056, crc_bits=32,\n                 janela_s=1.0, aquecimento_s=0.0,\
      \ imprimir=False):\n        gr.basic_block.__init__(\n            self,\n  \
      \          name=\"Monitor BLER/vaz\xE3o\",\n            in_sig=[np.float32],\n\
      \            out_sig=[np.float32] * 8,\n        )\n        self.set_tag_propagation_policy(gr.TPP_DONT)\n\
      \        self.message_port_register_in(pmt.intern(\"ok\"))\n        self.message_port_register_in(pmt.intern(\"\
      fail\"))\n        self.set_msg_handler(pmt.intern(\"ok\"), self._quadro_ok)\n\
      \        self.set_msg_handler(pmt.intern(\"fail\"), self._quadro_fail)\n\n \
      \       self.taxa_relogio = float(taxa_relogio)\n        self.bits_por_quadro_tx\
      \ = int(bits_por_quadro_tx)\n        self.crc_bits = int(crc_bits)\n       \
      \ self.janela_s = float(janela_s)\n        self.aquecimento_s = float(aquecimento_s)\n\
      \        self.imprimir = bool(imprimir)\n        self._aquecendo = self.aquecimento_s\
      \ > 0\n\n        # contadores acumulados\n        self.relogio = 0         \
      \ # itens consumidos na entrada 0\n        self.recebidos = 0        # quadros\
      \ que chegaram ao decodificador (ok + fail)\n        self.validos = 0      \
      \    # quadros com CRC ok\n        self.bits_recebidos = 0   # bits entregues\
      \ pelo decodificador (com CRC)\n        self.bits_validos = 0     # bits \xFA\
      teis dos quadros v\xE1lidos\n\n        # estado do \xFAltimo relat\xF3rio\n\
      \        self._ult = (0, 0, 0, 0, 0)\n        self._t_parede_0 = time.monotonic()\n\
      \        self._t_parede_ult = self._t_parede_0\n        self._prox_relatorio\
      \ = self.janela_s\n\n    def forecast(self, noutput_items, ninputs):\n     \
      \   # Exige >= 1 item do rel\xF3gio. Com 0, o escalonador chamaria general_work\n\
      \        # em loop sempre que houvesse espa\xE7o de sa\xEDda (bloco com sa\xED\
      das nunca\n        # \"dorme\" por falta de entrada), disputando o GIL com a\
      \ GUI.\n        return [1] * ninputs\n\n    # ---- portas de mensagem (rodam\
      \ na mesma thread do general_work)\n    def _bits_pdu(self, msg):\n        return\
      \ 8 * pmt.length(pmt.cdr(msg))\n\n    def _quadro_ok(self, msg):\n        n\
      \ = self._bits_pdu(msg)\n        self.recebidos += 1\n        self.validos +=\
      \ 1\n        self.bits_recebidos += n + self.crc_bits\n        self.bits_validos\
      \ += n\n\n    def _quadro_fail(self, msg):\n        self.recebidos += 1\n  \
      \      self.bits_recebidos += self._bits_pdu(msg) + self.crc_bits\n\n    # ----\
      \ rel\xF3gio e relat\xF3rio\n    def general_work(self, input_items, output_items):\n\
      \        n = len(input_items[0])\n        if n:\n            self.relogio +=\
      \ n\n            self.consume(0, n)\n\n        T = self.relogio / self.taxa_relogio\n\
      \        if self._aquecendo and T >= self.aquecimento_s:\n            self._aquecendo\
      \ = False\n            self.relogio = self.recebidos = self.validos = 0\n  \
      \          self.bits_recebidos = self.bits_validos = 0\n            self._ult\
      \ = (0, 0, 0, 0, 0)\n            self._t_parede_0 = self._t_parede_ult = time.monotonic()\n\
      \            self._prox_relatorio = self.janela_s\n            if self.imprimir:\n\
      \                print(f\"[aquecimento] {T:.2f}s de sinal descartados; contadores\
      \ zerados\", flush=True)\n            return 0\n\n        if T >= self._prox_relatorio\
      \ and len(output_items[0]) >= 1:\n            self._prox_relatorio = (T // self.janela_s\
      \ + 1) * self.janela_s\n            for k, v in enumerate(self._relatorio()):\n\
      \                output_items[k][0] = v\n            return 1\n        return\
      \ 0\n\n    def _metricas(self, n_itens, rec, val, brec, bval):\n        T =\
      \ n_itens / self.taxa_relogio\n        esperados = n_itens / self.bits_por_quadro_tx\
      \   # exato se n_itens for m\xFAltiplo do quadro\n        bler = 1.0 - val /\
      \ rec if rec else float(\"nan\")\n        fer = 1.0 - val / esperados if esperados\
      \ else float(\"nan\")\n        vazao = brec / T if T else 0.0\n        goodput\
      \ = bval / T if T else 0.0\n        return T, esperados, bler, fer, vazao, goodput\n\
      \n    def _relatorio(self):\n        agora = time.monotonic()\n        rel_u,\
      \ rec_u, val_u, brec_u, bval_u = self._ult\n        linhas = (\n           \
      \ (\"janela\", self.relogio - rel_u, agora - self._t_parede_ult,\n         \
      \    self.recebidos - rec_u, self.validos - val_u,\n             self.bits_recebidos\
      \ - brec_u, self.bits_validos - bval_u),\n            (\"total \", self.relogio,\
      \ agora - self._t_parede_0,\n             self.recebidos, self.validos, self.bits_recebidos,\
      \ self.bits_validos),\n        )\n        valores = []\n        for rotulo,\
      \ dN, dTp, rec, val, brec, bval in linhas:\n            dT, esp, bler, fer,\
      \ vazao, goodput = self._metricas(dN, rec, val, brec, bval)\n            valores\
      \ += [bler, fer, vazao, goodput]\n            if self.imprimir:\n          \
      \      print(\n                    f\"[{rotulo}] sinal={dT:7.2f}s parede={dTp:7.2f}s\
      \  \"\n                    f\"esperados={esp:9.1f} recebidos={rec:7d} v\xE1\
      lidos={val:7d}  \"\n                    f\"BLER={bler:.3e} FER={fer:.3e}  \"\
      \n                    f\"vaz\xE3o={vazao / 1e3:7.1f} kb/s goodput={goodput /\
      \ 1e3:7.1f} kb/s\",\n                    flush=True,\n                )\n  \
      \      self._ult = (self.relogio, self.recebidos, self.validos, self.bits_recebidos,\
      \ self.bits_validos)\n        self._t_parede_ult = agora\n        return valores\n"
    affinity: ''
    alias: ''
    aquecimento_s: '1.0'
    bits_por_quadro_tx: sync_len + N
    comment: ''
    crc_bits: '32'
    imprimir: 'False'
    janela_s: '0.125'
    maxoutbuf: '0'
    minoutbuf: '0'
    taxa_relogio: bit_rate
  states:
    _io_cache: "('Monitor BLER/vaz\xE3o', 'blk', [('taxa_relogio', '800000.0'), ('bits_por_quadro_tx',\
      \ '1056'), ('crc_bits', '32'), ('janela_s', '1.0'), ('aquecimento_s', '0.0'),\
      \ ('imprimir', 'False')], [('0', 'float', 1), ('fail', 'message', 1), ('ok',\
      \ 'message', 1)], [('0', 'float', 1), ('1', 'float', 1), ('2', 'float', 1),\
      \ ('3', 'float', 1), ('4', 'float', 1), ('5', 'float', 1), ('6', 'float', 1),\
      \ ('7', 'float', 1)], '\\nMonitor de BLER e vaz\xE3o a partir das portas de\
      \ mensagem do CRC Check.\\n\\nMensagens \\'ok\\' e \\'fail\\': PDUs vindas do\
      \ CRC Check (com Discard CRC = Yes as\\n    duas chegam sem o CRC; crc_bits\
      \ \xE9 somado de volta para contar a vaz\xE3o).\\n    Cada PDU \xE9 um quadro\
      \ que chegou ao decodificador; \\'ok\\' \xE9 um quadro v\xE1lido.\\n\\nEntrada\
      \ 0 (float): sa\xEDda do Constellation Soft Decoder (LLRs). Serve s\xF3 de\\\
      n    rel\xF3gio: cada item vale 1/taxa_relogio segundos de sinal (2 LLRs por\\\
      n    s\xEDmbolo QPSK => taxa_relogio = bit_rate). O tempo \xE9 medido em \"\
      tempo de\\n    sinal\", independente do throttle, e os quadros perdidos no sincronismo\\\
      n    (que nunca viram PDU) entram na conta.\\n\\nA cada janela_s segundos de\
      \ sinal emite (e, com imprimir=True, imprime):\\n    esperados = T * taxa_relogio\
      \ / bits_por_quadro_tx   (quadros transmitidos)\\n    BLER      = 1 - v\xE1\
      lidos/recebidos      (s\xF3 quadros que chegaram ao decodificador)\\n    FER\
      \       = 1 - v\xE1lidos/esperados      (inclui quadros perdidos no sincronismo)\\\
      n    vaz\xE3o     = bits que saem do decodificador (com CRC) / T\\n    goodput\
      \   = bits \xFAteis dos quadros v\xE1lidos / T\\n\\naquecimento_s: tempo de\
      \ sinal descartado no in\xEDcio (transit\xF3rio de aquisi\xE7\xE3o);\\n    ao\
      \ fim dele todos os contadores s\xE3o zerados.\\n\\nSa\xEDdas (float, um item\
      \ por relat\xF3rio, para QT GUI Number Sink):\\n    0 BLER  1 FER  2 vaz\xE3\
      o [bit/s]  3 goodput [bit/s]   -- janela\\n    4 BLER  5 FER  6 vaz\xE3o [bit/s]\
      \  7 goodput [bit/s]   -- total\\n', ['aquecimento_s', 'bits_por_quadro_tx',\
      \ 'crc_bits', 'imprimir', 'janela_s', 'taxa_relogio'])"
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2680, 592.0]
    rotation: 0
    state: enabled
- name: epy_block_0_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nimport pmt\nfrom gnuradio import gr\n\n\nclass\
      \ blk(gr.basic_block):\n    \"\"\"\n    Find Access Code \u2014 invariante \xE0\
      s quatro ambiguidades de fase da QPSK.\n\n    Procura o access code no fluxo\
      \ de LLRs correlacionando, em paralelo, contra\n    as quatro vers\xF5es do\
      \ c\xF3digo correspondentes \xE0s rota\xE7\xF5es de 0\xB0, 90\xB0, 180\xB0 e\n\
      \    270\xB0 da constela\xE7\xE3o. Ao encontrar, desfaz a rota\xE7\xE3o no payload\
      \ antes de\n    repass\xE1-lo adiante, de modo que o Costas Loop pode travar\
      \ em qualquer uma\n    das quatro fases sem quebrar o enquadramento.\n    \"\
      \"\"\n\n    def __init__(self, access_code=\"\", payload_len_in_bits=0, tag_key=\"\
      \", threshold=0.9):\n        gr.basic_block.__init__(\n            self,\n \
      \           name='Find Access Code',\n            in_sig=[np.float32],\n   \
      \         out_sig=[np.float32],\n        )\n        ac = np.array([2 * int(b)\
      \ - 1 for b in access_code], dtype=np.float32)\n        if ac.size % 2 or payload_len_in_bits\
      \ % 2:\n            raise ValueError('access code e payload devem ter comprimento\
      \ par')\n        self.codes = np.stack([self._rot(ac, k) for k in range(4)])\n\
      \        self.ac_len = ac.size\n        self.pl_len = int(payload_len_in_bits)\n\
      \        self.frame_len = self.ac_len + self.pl_len\n        self.tag_key =\
      \ pmt.intern(tag_key)\n        self.threshold = threshold\n        if self.pl_len\
      \ > 0:\n            # Sob os valores padr\xE3o (payload 0) o GRC instancia o\
      \ bloco s\xF3 para\n            # inspecionar as portas; set_output_multiple(0)\
      \ daria erro ali.\n            self.set_output_multiple(self.pl_len)\n\n   \
      \ @staticmethod\n    def _rot(x, k):\n        \"\"\"Aplica k rota\xE7\xF5es\
      \ de +90\xB0 ao fluxo de LLRs (cada par de LLRs = 1 s\xEDmbolo).\"\"\"\n   \
      \     y = x.reshape(-1, 2).copy()\n        for _ in range(k % 4):\n        \
      \    a = y[:, 0].copy()\n            y[:, 0] = y[:, 1]\n            y[:, 1]\
      \ = -a\n        return y.reshape(-1)\n\n    def forecast(self, noutput_items,\
      \ ninputs):\n        return [self.frame_len] * ninputs\n\n    def general_work(self,\
      \ input_items, output_items):\n        in0 = input_items[0]\n        out0 =\
      \ output_items[0]\n\n        if self.pl_len <= 0:\n            return 0\n  \
      \      if in0.size < self.frame_len or out0.size < self.pl_len:\n          \
      \  return 0\n\n        # Busca vetorizada: testa de uma vez todos os offsets\
      \ em que ainda cabe\n        # um quadro inteiro, limitada a um per\xEDodo de\
      \ quadro por chamada.\n        last = min(in0.size - self.frame_len, self.frame_len\
      \ - 1)\n        w = np.lib.stride_tricks.sliding_window_view(in0[:last + self.ac_len],\
      \ self.ac_len)\n        energy = np.abs(w).sum(axis=1)\n        metric = (w\
      \ @ self.codes.T) / np.where(energy > 0.0, energy, np.inf)[:, None]\n\n    \
      \    idx = np.flatnonzero(metric.max(axis=1) >= self.threshold)\n        if\
      \ idx.size == 0:\n            self.consume(0, last + 1)   # descarta o que j\xE1\
      \ foi testado, guarda a cauda\n            return 0\n\n        n = int(idx[0])\
      \                      # primeiro quadro do bloco\n        k = int(np.argmax(metric[n]))\
      \        # qual das 4 rota\xE7\xF5es casou\n        payload = in0[n + self.ac_len:\
      \ n + self.frame_len]\n        out0[:self.pl_len] = self._rot(payload, -k) \
      \  # desfaz a rota\xE7\xE3o\n        self.consume(0, n + self.frame_len)\n \
      \       self.add_item_tag(0, self.nitems_written(0), self.tag_key, pmt.from_long(self.pl_len))\n\
      \        return self.pl_len\n"
    access_code: access_code
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    payload_len_in_bits: N
    tag_key: '"quadro"'
    threshold: '0.6'
  states:
    _io_cache: "('Find Access Code', 'blk', [('access_code', \"''\"), ('payload_len_in_bits',\
      \ '0'), ('tag_key', \"''\"), ('threshold', '0.9')], [('0', 'float', 1)], [('0',\
      \ 'float', 1)], '\\nFind Access Code \u2014 invariante \xE0s quatro ambiguidades\
      \ de fase da QPSK.\\n\\nProcura o access code no fluxo de LLRs correlacionando,\
      \ em paralelo, contra\\nas quatro vers\xF5es do c\xF3digo correspondentes \xE0\
      s rota\xE7\xF5es de 0\xB0, 90\xB0, 180\xB0 e\\n270\xB0 da constela\xE7\xE3o.\
      \ Ao encontrar, desfaz a rota\xE7\xE3o no payload antes de\\nrepass\xE1-lo adiante,\
      \ de modo que o Costas Loop pode travar em qualquer uma\\ndas quatro fases sem\
      \ quebrar o enquadramento.\\n', ['tag_key', 'threshold'])"
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1440, 952.0]
    rotation: 0
    state: enabled
